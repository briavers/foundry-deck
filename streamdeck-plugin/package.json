{
  "name": "foundry-deck-streamdeck",
  "version": "0.1.0",
  "private": true,
  "description": "Stream Deck plugin that controls Foundry VTT through the Foundry Deck module.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.briavers.foundry-deck\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "validate": "streamdeck validate com.briavers.foundry-deck.sdPlugin",
    "pack": "npm run build && streamdeck pack com.briavers.foundry-deck.sdPlugin --output dist --force"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "~24.1.0",
    "@types/ws": "^8.18.1",
    "rollup": "^4.63.5",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.0",
    "@elgato/utils": "^0.6.0",
    "ws": "^8.21.3"
  }
}
